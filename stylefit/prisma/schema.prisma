// Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement()) // 자동 증가하는 정수형 기본 키
  email           String   @unique                       // 사용자 이메일, 유일해야 함
  passwordHash    String                                   // 암호 해시 저장
  name            String                                   // 사용자 이름
  profileImageUrl String?                                  // 프로필 이미지 URL (선택)
  agreedTermsAt   DateTime                                 // 이용 약관 동의 시간
  createdAt       DateTime @default(now())                 // 생성 시각, 기본값 지금
  updatedAt       DateTime @updatedAt                      // 수정 시 자동 업데이트
  isActive        Boolean  @default(true)                  // 계정 활성 여부
  // 권한 모델 (Day 14) — admin 만 /admin/* 화면 접근 가능.
  // default "user" 이라 신규 가입은 자동으로 일반 사용자. admin은 *명시적 부여* 필요.
  // Day 17: String → enum
  role            UserRole @default(user)

  sellerProfile   SellerProfile?                         // 셀러 프로필 1:1 관계
  bookings        Booking[]   @relation("BookingBuyer")  // 구매자 예약 목록
  reviews         Review[]    @relation("ReviewBuyer")   // 구매자가 작성한 후기 목록
  messageThreads  MessageThread[] @relation("ThreadBuyer") // 구매자로서 참여한 대화방 목록
  sentMessages    Message[]   @relation("MessageSender")   // 발신한 메시지 목록
  auditLogs       AuditLog[]                              // 이 user 가 actor 인 감사 로그 (Day 18)

  @@map("users")
}

model SellerProfile {
  id                Int      @id @default(autoincrement())      // 셀러 프로필 기본 키
  userId            Int      @unique                            // 연결된 사용자 ID, 1:1 관계
  bio               String?                                  // 셀러 소개글
  specialty         String?                                  // 셀러 전문 분야
  // Day 17: String → enum (Service.verificationStatus 와 *값은 같지만 도메인 분리*)
  verificationStatus SellerVerificationStatus @default(pending)
  rejectionReason   String?                                   // 반려 사유 (rejected일 때 작성됨, 셀러에게 표시) — Day 14
  instagramHandle   String?                                  // 인스타그램 핸들
  portfolioUrls     String?                                  // 포트폴리오 URL 배열을 JSON 문자열로 저장
  approvedAt        DateTime?                                // 셀러 승인 시간
  createdAt         DateTime @default(now())                 // 생성 시각
  updatedAt         DateTime @updatedAt                      // 수정 시 자동 업데이트

  user        User      @relation(fields: [userId], references: [id]) // User와 1:1 관계
  services    Service[]                                   // 셀러가 등록한 서비스들
  bookings    Booking[]                                   // 셀러가 받은 예약 목록
  reviews     Review[]                                    // 셀러가 받은 후기 목록
  messageThreads MessageThread[]                          // 셀러로서 참여한 대화방 목록
  activityLogs SellerActivityLog[]                        // 이 셀러의 활동 이력 (Day 20)

  @@map("seller_profiles")
}

model Service {
  id              Int            @id @default(autoincrement()) // 서비스 기본 키
  sellerProfileId Int                                        // 등록한 셀러 프로필 ID
  title           String                                     // 서비스 제목
  description     String                                     // 서비스 상세 설명
  serviceType     ServiceType                                // 서비스 형태 (Day 17: String → enum)
  category        String                                     // 서비스 카테고리
  price           Int                                        // 서비스 가격 (원 단위)
  durationMinutes Int                                        // 서비스 소요 시간 (분)
  isActive        Boolean        @default(true)               // 서비스 활성 여부 (셀러가 토글)
  // 운영자 검증 상태 (Day 13). 신규 등록은 default pending → /services 노출 안 됨.
  // 시드 데이터는 명시적으로 "approved" 지정 (단 Day 14 admin 검증용 *pending 2개*는 예외).
  // Day 17: String → enum 으로 교체 (DB 수준 타입 안전성)
  verificationStatus ServiceVerificationStatus @default(pending)
  rejectionReason String?                                    // 반려 사유 (rejected일 때 작성됨, 셀러에게 표시) — Day 14
  createdAt       DateTime       @default(now())              // 생성 시각
  updatedAt       DateTime       @updatedAt                  // 수정 시 자동 업데이트

  sellerProfile   SellerProfile  @relation(fields: [sellerProfileId], references: [id]) // 셀러 프로필과 관계
  bookings        Booking[]                                   // 이 서비스에 대한 예약 목록
  collections     ServiceCollection[]                         // 이 서비스가 속한 컬렉션들 (다대다, Day 12)
  activityLogs    SellerActivityLog[]                         // 이 서비스에 대한 셀러 활동 이력 (Day 20)

  @@map("services")
}

// 큐레이션 컬렉션 (Day 12)
// 예: "에디터 추천", "지금 핫한 서비스" 같은 묶음을 표현.
// 운영자가 *어떤 서비스를 어떤 묶음에 넣을지* 결정 — 운영 유연성.
model Collection {
  id           Int                 @id @default(autoincrement())
  slug         String              @unique  // URL/쿼리용 식별자 (예: "featured", "hot")
  name         String              // 화면에 표시되는 이름 (예: "에디터 추천")
  displayOrder Int                 @default(0)  // 페이지에서 컬렉션 간 정렬
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  services     ServiceCollection[] // 이 컬렉션에 속한 서비스들 (다대다)

  @@map("collections")
}

// 매핑 테이블 — Collection ↔ Service 다대다 관계 표현 (Day 12)
//
// Implicit 다대다 (Prisma가 자동 생성)도 가능하지만 *displayOrder*처럼
// 매핑 자체에 메타 데이터를 붙이려면 explicit 매핑 테이블이 필요.
// 한 서비스가 *"추천"에선 1번, "핫"에선 3번*처럼 *컬렉션별 다른 순서* 가능.
model ServiceCollection {
  collectionId Int
  serviceId    Int
  displayOrder Int      @default(0)  // 이 컬렉션 안에서 서비스 표시 순서
  createdAt    DateTime @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id])
  service      Service    @relation(fields: [serviceId], references: [id])

  // 복합 기본 키 — (컬렉션, 서비스) 조합이 유일.
  // 같은 서비스를 같은 컬렉션에 두 번 넣을 수 없음.
  @@id([collectionId, serviceId])
  @@map("service_collections")
}

model Booking {
  id                Int            @id @default(autoincrement())           // 예약 기본 키
  buyerId           Int                                                  // 구매자 ID
  serviceId         Int                                                  // 예약한 서비스 ID
  sellerProfileId   Int                                                  // 중복 저장된 셀러 프로필 ID
  preferredDatetime DateTime                                             // 구매자가 원한 시간
  confirmedDatetime DateTime?                                            // 셀러가 확정한 시간
  // Day 17: String → enum
  status            BookingStatus  @default(pending)
  buyerMemo         String?                                               // 구매자 메모
  rejectionReason   String?                                               // 셀러 거절 시 사유 (Day 21).
  cancellationReason String?                                              // buyer 취소 시 사유 (Day 22). 두 컬럼 *위치로* 누가 결정했는지 자동 구분 (Day 21 의 *enum 분리 X* 정신 일관)
  createdAt         DateTime       @default(now())                         // 생성 시각
  updatedAt         DateTime       @updatedAt                             // 수정 시 자동 업데이트

  buyer             User           @relation("BookingBuyer", fields: [buyerId], references: [id]) // 구매자와 관계
  service           Service        @relation(fields: [serviceId], references: [id]) // 서비스와 관계
  sellerProfile     SellerProfile  @relation(fields: [sellerProfileId], references: [id]) // 셀러 프로필과 관계
  review            Review?                                                          // 이 예약에 대한 후기 (1:1, 선택)
  messageThread     MessageThread?                                                   // 예약과 연결된 대화방 (1:1, 선택)

  @@map("bookings")
}

model Review {
  id              Int            @id @default(autoincrement())           // 후기 기본 키
  bookingId       Int            @unique                                // 예약 ID, 1:1 관계
  buyerId         Int                                                  // 후기 작성한 구매자 ID (비정규화)
  sellerProfileId Int                                                  // 셀러 프로필 ID (비정규화)
  rating          Int                                                  // 별점 (1~5)
  content         String                                              // 후기 본문
  imageUrls       String?                                             // 이미지 URL 배열을 JSON 문자열로 저장
  createdAt       DateTime       @default(now())                        // 생성 시각
  updatedAt       DateTime       @updatedAt                             // 수정 시 자동 업데이트

  booking         Booking        @relation(fields: [bookingId], references: [id])        // 예약과 1:1 관계
  buyer           User           @relation("ReviewBuyer", fields: [buyerId], references: [id]) // 구매자와 관계
  sellerProfile   SellerProfile  @relation(fields: [sellerProfileId], references: [id]) // 셀러 프로필과 관계

  @@map("reviews")
}

model MessageThread {
  id              Int            @id @default(autoincrement())           // 대화방 기본 키
  buyerId         Int                                                  // 구매자 ID
  sellerProfileId Int                                                  // 셀러 프로필 ID
  relatedBookingId Int?           @unique                                // 관련 예약 ID (선택, 1:1 고유)
  lastMessageAt   DateTime?                                            // 마지막 메시지 시간
  createdAt       DateTime       @default(now())                        // 생성 시각
  updatedAt       DateTime       @updatedAt                             // 수정 시 자동 업데이트

  buyer           User           @relation("ThreadBuyer", fields: [buyerId], references: [id]) // 구매자와 관계
  sellerProfile   SellerProfile  @relation(fields: [sellerProfileId], references: [id]) // 셀러 프로필과 관계
  relatedBooking  Booking?       @relation(fields: [relatedBookingId], references: [id]) // 관련 예약과 관계
  messages        Message[]                                             // 이 대화방의 메시지들

  @@map("message_threads")
}

model Message {
  id        Int           @id @default(autoincrement())           // 메시지 기본 키
  threadId  Int                                                  // 대화방 ID
  senderId  Int                                                  // 발신자 ID
  content   String                                              // 메시지 내용
  imageUrls String?                                             // 이미지 URL 배열을 JSON 문자열로 저장
  isRead    Boolean       @default(false)                         // 읽음 여부
  createdAt DateTime      @default(now())                         // 생성 시각

  thread    MessageThread @relation(fields: [threadId], references: [id]) // 대화방과 관계
  sender    User          @relation("MessageSender", fields: [senderId], references: [id]) // 발신자와 관계

  // 복합 인덱스 (Day 30) — `/bookings/[id]/messages` 의 핵심 쿼리:
  //   where: { threadId } orderBy: { createdAt asc }
  // audit-log 의 (createdAt) / 셀러 활동의 (sellerProfileId, createdAt) 와 동일 패턴 —
  // *한정 조건 + createdAt* 복합. B-tree 라 asc/desc 양방향 활용.
  @@index([threadId, createdAt])
  @@map("messages")
}

// ───────────── 감사 로그 (Day 18) ─────────────

// 운영자(admin) 액션의 *이력 events*. snapshot 아닌 *추가 전용* 테이블 — 한번 들어가면 안 지움.
//
// 설계 포인트:
//   - (action, targetType) 조합으로 의미 분리 — Day 17 의 enum 도메인 분리의 *반대* 케이스.
//     값(approved/rejected/reverted)은 같고 도메인(Seller/Service)만 다르면 *공통 enum* 으로 모음.
//   - targetId 는 FK 없이 Int — Seller/Service polymorphic 이라 single-table FK 안 맞음.
//     코드 측에서 (targetType, targetId) 로 resolve.
//   - actor FK 는 *default Restrict* — audit log 가 있는 user 삭제 불가 (감사 정책).
//   - metadata Json? — rejected 사유 같은 추가 컨텍스트. approved/reverted 는 null.
model AuditLog {
  id          Int              @id @default(autoincrement())
  actorId     Int                                          // 액션 수행자 (admin)
  action      AuditAction                                  // 무엇을 했나
  targetType  AuditTargetType                              // 대상 종류
  targetId    Int                                          // 대상의 id (도메인 가변 — FK 없음)
  metadata    Json?                                        // 추가 컨텍스트 (예: { rejectionReason })
  createdAt   DateTime         @default(now())

  actor       User             @relation(fields: [actorId], references: [id])

  // 최신순 조회의 핵심 — `/admin/audit-log` 가 자주 두드림. 필터 인덱스는 Day 19 추출 이후 판단.
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────── 셀러 활동 이력 (Day 20) ─────────────

// 셀러 본인의 활동 events. AuditLog 와 *의도적으로 분리* — 의미·권한·UX 가 다른 도메인이라.
//   - AuditLog: admin 의 *심사 추적*. 운영자만 조회.
//   - SellerActivityLog: 셀러의 *내 서비스 변경 이력*. 셀러는 *자기 것만* 조회.
//
// 설계 차이 (vs AuditLog):
//   - actor 가 sellerProfileId 로 명확 — *셀러 본인이 본인 액션 기록*
//   - target 이 단일 도메인 (Service) → polymorphic 안 필요. FK 가능.
//   - 인덱스 (sellerProfileId, createdAt) 복합 — *셀러별 최신순 조회* 가 핵심 쿼리라 단일 createdAt
//     인덱스로는 부족. 셀러별 필터링 + 정렬을 한 번에 활용.
//   - FK 모두 default Restrict — 이력 보존 (Day 18 정신).
model SellerActivityLog {
  id              Int             @id @default(autoincrement())
  sellerProfileId Int                                            // 활동의 주체 (셀러)
  activity        SellerActivity                                 // 무엇을 했나
  serviceId       Int                                            // 어떤 서비스에 대한 활동
  metadata        Json?                                          // 부가 컨텍스트 (toggled 의 to: bool 등)
  createdAt       DateTime        @default(now())

  sellerProfile   SellerProfile   @relation(fields: [sellerProfileId], references: [id])
  service         Service         @relation(fields: [serviceId], references: [id])

  // 복합 인덱스 — `/seller/activity-log` 의 핵심 쿼리:
  //   where: { sellerProfileId } orderBy: { createdAt desc }
  // 단일 createdAt 인덱스로는 *전체 시간순* 만 빠르고 셀러별 필터 후 정렬은 부분 활용에 그침.
  @@index([sellerProfileId, createdAt])
  @@map("seller_activity_logs")
}

// ───────────── Enums (Day 17) ─────────────

// 운영자가 서비스 등록을 검증한 결과.
// pending 은 신규 등록 default — /services 에 노출되지 않음.
// approved 만 노출 대상, rejected 는 셀러 화면에서 사유와 함께 표시.
enum ServiceVerificationStatus {
  pending
  approved
  rejected
}

// 운영자가 셀러(사람) 자격을 검증한 결과.
// ServiceVerificationStatus 와 값은 같지만 *도메인이 다름* — 분리해서 정의.
// 한쪽 도메인에 값이 추가되어도 다른 쪽이 흔들리지 않음.
enum SellerVerificationStatus {
  pending
  approved
  rejected
}

// 서비스 제공 형태 — 온라인/오프라인.
enum ServiceType {
  online
  offline
}

// 예약 진행 상태.
// pending: 구매자 요청 후 셀러 확정 대기
// confirmed: 셀러가 시간 확정
// completed: 서비스 종료
// cancelled: 취소
enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

// 사용자 권한. admin 만 /admin/* 화면 접근.
enum UserRole {
  user
  admin
}

// ───────────── Enums (Day 18) ─────────────

// 감사 로그의 액션 종류. targetType 과 *조합* 으로 의미 완성 (단독으론 불완전).
// Day 17 의 enum 도메인 분리 (Seller/ServiceVerificationStatus) 와 *반대* 결 —
// *값이 같고 도메인만 다른* 경우는 *공통 enum 으로 모으는 게 자연*.
enum AuditAction {
  approved
  rejected
  reverted
}

// 감사 로그의 대상 도메인. 미래에 Booking/Review 등 추가 가능 — *우리 코드 안에서만* 확장.
enum AuditTargetType {
  Seller
  Service
}

// ───────────── Enums (Day 20) ─────────────

// 셀러 활동의 종류. AuditAction (approved/rejected/reverted) 과 *의미 다른 도메인* 이라 분리.
//   - created: 새 서비스 등록
//   - updated: 기존 서비스 수정 (재검증 강제 — Day 15 정신)
//   - toggled: isActive 토글 (방향은 metadata.to 에 기록)
//   - bookingConfirmed/bookingRejected: 예약 확정·거절 (Day 21). serviceId 는 *그 예약의 service*,
//     metadata.bookingId 로 어떤 예약인지 보존. bookingRejected 는 metadata.rejectionReason 도 추가.
//   - bookingCompleted: 예약 완료 처리 (Day 24). 셀러가 *서비스 마침* 표시 — confirmed → completed.
//     이후 buyer 가 후기 작성 가능 (Review 모델 활성화).
enum SellerActivity {
  created
  updated
  toggled
  bookingConfirmed
  bookingRejected
  bookingCompleted
}
